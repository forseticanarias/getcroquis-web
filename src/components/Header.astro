---
import { SITE } from '../consts';
// Navegación limpia (sin emoji: se veían de "plastilina" en el menú móvil).
const links = [
  { href: '/empezar', label: 'Empieza aquí' },
  { href: '/destinos', label: 'Destinos' },
  { href: '/comparar', label: 'Comparar' },
  { href: '/guias', label: 'Guías' },
  { href: `${SITE.appUrl}/explora`, label: 'Explora la comunidad' },
  { href: '/creadores', label: 'Para creadores' },
  { href: '/agencias', label: 'Para agencias' },
];
---
<header class="relative z-30 max-w-5xl mx-auto px-5 sm:px-6 py-4 flex items-center justify-between gap-2">
  <a href="/" class="font-black text-xl sm:text-2xl tracking-tight bg-gradient-to-r from-tirma-pink to-tirma-beige bg-clip-text text-transparent">
    getcroquis
  </a>

  <!-- Escritorio -->
  <nav class="hidden sm:flex items-center gap-1 text-sm">
    <a href="/empezar" class="text-tirma-beige/90 hover:text-tirma-beige font-semibold px-3 py-1.5">Empieza aquí</a>
    <a href="/destinos" class="text-white/60 hover:text-white px-3 py-1.5">Destinos</a>
    <a href="/comparar" class="text-white/60 hover:text-white px-3 py-1.5">Comparar</a>
    <a href="/guias" class="text-white/60 hover:text-white px-3 py-1.5">Guías</a>
    <!-- Profesionales: a mano arriba, con desplegable a creadores/agencias (hover, sin JS) -->
    <div class="relative group">
      <a href="/creadores" class="text-white/60 hover:text-white px-3 py-1.5 inline-flex items-center gap-1 cursor-pointer">
        Profesionales
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </a>
      <div class="absolute right-0 top-full pt-2 hidden group-hover:block z-40">
        <div class="w-60 rounded-2xl border border-white/10 bg-[#0d1016] p-2 shadow-2xl shadow-black/50">
          <a href="/creadores" class="block px-3 py-2 rounded-xl text-sm text-white/80 hover:bg-white/[0.06] hover:text-white transition">Para creadores e influencers</a>
          <a href="/agencias" class="block px-3 py-2 rounded-xl text-sm text-white/80 hover:bg-white/[0.06] hover:text-white transition">Para agencias</a>
          <a href="/colaboradores" class="block px-3 py-2 rounded-xl text-sm text-white/50 hover:bg-white/[0.06] hover:text-white transition">Agencias colaboradoras</a>
        </div>
      </div>
    </div>
    <a href={`${SITE.appUrl}/dashboard`} class="font-bold px-3.5 py-1.5 rounded-full bg-gradient-to-r from-tirma-pink to-tirma-deep text-tirma-beige shadow-lg shadow-tirma-pink/25 whitespace-nowrap ml-1">Abrir app</a>
  </nav>

  <!-- Móvil: Abrir app + menú -->
  <div class="flex items-center gap-2 sm:hidden">
    <a href={`${SITE.appUrl}/dashboard`} class="font-bold text-xs px-3 py-2 rounded-full bg-gradient-to-r from-tirma-pink to-tirma-deep text-tirma-beige whitespace-nowrap">Abrir app</a>
    <button id="menu-btn" aria-label="Abrir menú" class="w-10 h-10 rounded-full border border-white/15 bg-white/[0.04] flex items-center justify-center text-white">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</header>

<!-- Panel de menú móvil -->
<div id="mobile-menu" class="sm:hidden fixed inset-0 z-40 hidden">
  <div id="menu-overlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
  <nav class="absolute top-0 right-0 h-full w-72 max-w-[85%] bg-[#0d1016] border-l border-white/10 p-5 flex flex-col gap-1 animate-[slideIn_0.2s_ease]" style="padding-top: calc(1.25rem + env(safe-area-inset-top));">
    <div class="flex items-center justify-between mb-4">
      <span class="font-black text-lg bg-gradient-to-r from-tirma-pink to-tirma-beige bg-clip-text text-transparent">getcroquis</span>
      <button id="menu-close" aria-label="Cerrar" class="w-9 h-9 rounded-full border border-white/10 flex items-center justify-center text-white/70">✕</button>
    </div>
    {links.map((l) => (
      <a href={l.href} class="px-3 py-3 rounded-xl text-white/85 hover:bg-white/[0.06] font-semibold transition">
        {l.label}
      </a>
    ))}
    <a href={`${SITE.appUrl}/dashboard`} class="mt-3 text-center px-4 py-3 rounded-xl bg-gradient-to-r from-tirma-pink to-tirma-deep text-tirma-beige font-bold">Abrir la app →</a>

    <!-- Redes: accesos directos al pie del desplegable (iconos, no texto) -->
    <div class="mt-auto pt-5 border-t border-white/[0.08]">
      <p class="text-[11px] uppercase tracking-[0.15em] text-white/35 mb-3">Síguenos</p>
      <div class="flex items-center gap-2.5">
        <a href={SITE.instagram} target="_blank" rel="noreferrer" aria-label="Instagram"
           class="w-10 h-10 rounded-full border border-white/12 bg-white/[0.04] flex items-center justify-center text-white/70 hover:text-tirma-pink hover:border-tirma-pink/40 transition">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>
        </a>
        <a href={SITE.tiktok} target="_blank" rel="noreferrer" aria-label="TikTok"
           class="w-10 h-10 rounded-full border border-white/12 bg-white/[0.04] flex items-center justify-center text-white/70 hover:text-tirma-pink hover:border-tirma-pink/40 transition">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 3a5.6 5.6 0 0 0 4.5 4.5v3a8.5 8.5 0 0 1-4.5-1.3v6.3a6 6 0 1 1-6-6c.34 0 .67.03 1 .09v3.14a2.9 2.9 0 1 0 2 2.77V3z"/></svg>
        </a>
      </div>
    </div>
  </nav>
</div>

<style>
  @keyframes slideIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
</style>
<script>
  const menu = document.getElementById('mobile-menu');
  const open = () => { menu?.classList.remove('hidden'); document.body.style.overflow = 'hidden'; };
  const close = () => { menu?.classList.add('hidden'); document.body.style.overflow = ''; };
  document.getElementById('menu-btn')?.addEventListener('click', open);
  document.getElementById('menu-close')?.addEventListener('click', close);
  document.getElementById('menu-overlay')?.addEventListener('click', close);
  // Cerrar con Escape y al pasar a escritorio (que no quede el scroll bloqueado).
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  window.addEventListener('resize', () => { if (window.innerWidth >= 640) close(); });
</script>
