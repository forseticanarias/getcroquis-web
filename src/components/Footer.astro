---
import { SITE } from '../consts';
const year = new Date().getFullYear();

// Footer organizado en columnas (estilo blog de referencia): cada sección con
// sus enlaces. Los legales viven en la app (mismo dominio, /legal/*).
// Footer en columnas temáticas y sin duplicados (las redes viven en el bloque de
// marca; "Abrir app" en la cabecera). Anchor text claro = mejor enlazado interno.
const cols = [
  {
    title: 'Explora',
    links: [
      { label: 'Empieza aquí', href: '/empezar' },
      { label: 'Destinos', href: '/destinos' },
      { label: 'Comparar países', href: '/comparar' },
      { label: 'Guías de viaje', href: '/guias' },
      { label: 'Explora la comunidad', href: `${SITE.appUrl}/explora` },
    ],
  },
  {
    title: 'Profesionales',
    links: [
      { label: 'getcroquis Pro: agencias, profesionales y hoteles', href: SITE.proUrl },
      { label: 'Planes y alta', href: SITE.proUrl },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacidad', href: `${SITE.appUrl}/legal/privacidad` },
      { label: 'Política de cookies', href: `${SITE.appUrl}/legal/cookies` },
      { label: 'Términos de uso', href: `${SITE.appUrl}/legal/terminos` },
      { label: 'Reembolsos', href: `${SITE.appUrl}/legal/reembolsos` },
      { label: 'Aviso legal', href: `${SITE.appUrl}/legal/aviso-legal` },
    ],
  },
];
---
<footer class="relative z-10 border-t border-white/[0.06] mt-16">
  <div class="max-w-5xl mx-auto px-6 py-8">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
      <!-- Marca -->
      <div class="col-span-2 sm:col-span-1">
        <a href="/" class="font-black text-xl tracking-tight bg-gradient-to-r from-tirma-pink to-tirma-beige bg-clip-text text-transparent">
          getcroquis
        </a>
        <p class="mt-3 text-sm text-white/45 leading-relaxed max-w-[14rem]">
          Tu referente de viajes: planifica con IA, descubre destinos y comparte tus rutas.
        </p>
        <div class="mt-4 flex flex-col gap-2">
          <a href={SITE.instagram} target="_blank" rel="noopener" aria-label="Síguenos en Instagram"
             class="inline-flex items-center gap-1.5 text-white/55 hover:text-tirma-pink transition text-sm">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            @getcroquis
          </a>
          <a href={SITE.tiktok} target="_blank" rel="noopener" aria-label="Síguenos en TikTok"
             class="inline-flex items-center gap-1.5 text-white/55 hover:text-tirma-pink transition text-sm">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M16.5 3h-2.7v13.1a2.4 2.4 0 1 1-2.4-2.4c.2 0 .5 0 .7.1v-2.8a5.2 5.2 0 1 0 4.4 5.1V8.9a6.3 6.3 0 0 0 3.7 1.2V7.3a3.6 3.6 0 0 1-3.7-3.6z"/>
            </svg>
            @getcroquis
          </a>
          <a href={SITE.playStore} target="_blank" rel="noopener" aria-label="Descarga getcroquis en Google Play"
             class="mt-1 inline-flex items-center gap-2 px-3 py-2 rounded-xl border border-white/15 bg-white/[0.04] hover:border-white/30 transition w-fit">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#34A853" d="M3.6 2.2 13.4 12l-9.8 9.8c-.4-.2-.6-.6-.6-1.1V3.3c0-.5.2-.9.6-1.1Z"/><path fill="#FBBC04" d="m16.7 15.3-3.3-3.3 3.3-3.3 3.8 2.2c1.1.6 1.1 1.6 0 2.2l-3.8 2.2Z"/><path fill="#EA4335" d="M16.7 15.3 13.4 12l-9.8 9.8c.4.2.9.2 1.4-.1l11.7-6.4Z"/><path fill="#4285F4" d="M16.7 8.7 5 2.3c-.5-.3-1-.3-1.4-.1l9.8 9.8 3.3-3.3Z"/></svg>
            <span class="leading-tight"><span class="block text-[10px] text-white/50">Disponible en</span><span class="block text-sm font-semibold text-white/85">Google Play</span></span>
          </a>
        </div>
      </div>

      <!-- Columnas de enlaces -->
      {cols.map((c) => (
        <div>
          <h3 class="text-xs font-bold tracking-widest text-white/40 uppercase mb-3">{c.title}</h3>
          <ul class="space-y-2">
            {c.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener' : undefined}
                  class="text-sm text-white/60 hover:text-white transition"
                >{l.label}</a>
              </li>
            ))}
            {c.title === 'Legal' && (
              <li>
                <button type="button" data-cookie-settings class="text-sm text-white/60 hover:text-white transition">
                  Configurar cookies
                </button>
              </li>
            )}
          </ul>
        </div>
      ))}
    </div>

    <!-- Barra inferior: copyright a la izquierda, frase centrada en todo el ancho -->
    <div class="mt-6 pt-6 border-t border-white/[0.06] text-xs text-white/35">
      <div class="relative flex flex-col items-center gap-2 sm:block sm:text-center sm:min-h-[1.25rem]">
        {/* ™ se puede usar sin registro; ® SOLO con la marca concedida (ver docs/PROTECCION-marca-y-software.md) */}
        <span class="sm:absolute sm:left-0 sm:top-1/2 sm:-translate-y-1/2">© {year} {SITE.name}™</span>
        <span class="inline-flex flex-wrap items-center justify-center gap-1.5">
          Hecho con
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="text-tirma-pink" aria-hidden="true">
            <path d="M12 21s-6.716-4.35-9.303-8.412C.9 9.897 2.005 6.5 5.001 6.5c1.9 0 3.2 1.1 3.999 2.3.8-1.2 2.1-2.3 4-2.3 2.996 0 4.101 3.397 2.303 6.088C18.716 16.65 12 21 12 21z"/>
          </svg>
          por personas que aman viajar
        </span>
      </div>
    </div>
  </div>
</footer>
