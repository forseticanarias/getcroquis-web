---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';

// Puerta "Agencias / Profesionales": discurso distinto al del creador. Aquí el
// dolor es CAPTAR clientes y DIGITALIZARSE, no monetizar una audiencia propia.
const props = [
  { t: 'Tu marca, no la nuestra', d: 'Marca blanca: el itinerario sale con tu logo y tus colores. Para tu cliente es un producto tuyo — nosotros no aparecemos.' },
  { t: 'Itinerarios 100% a medida, en minutos', d: 'La IA arma el día a día; tú lo curas con criterio. Propuestas a medida en minutos, no horas.' },
  { t: 'Clientes nuevos, no de tu barrio', d: 'Tu escaparate se posiciona y te encuentran viajeros de todo el mundo. Sin depender del local.' },
  { t: 'Un servicio más que vender', d: 'Vende el itinerario como complemento del viaje que ya cerraste: margen puro sobre un cliente que ya es tuyo.' },
  { t: 'En el idioma de tu cliente', d: 'Itinerarios en alemán o inglés automáticamente. En Canarias eso no es un extra: es el mercado.' },
  { t: 'Libertad total de servicios', d: 'Sesiones 1:1, asistencia, guía, seguros, tus referidos… cada extra a tu precio.' },
  { t: 'Cobros seguros con Stripe', d: 'Pago protegido: retenemos el importe hasta que tu cliente confirma. Solo cobramos si tú cobras.' },
  { t: 'CRM de viajes incluido', d: 'Estado de cada pedido y ficha del cliente. Sin montar nada.' },
  { t: 'Reputación que vende sola', d: 'Reseñas verificadas: tu comercial 24/7.' },
];
// Lo que incluye el plan Agencia. Fuente de verdad: get_plan_features('agency') en
// Supabase — si cambian ahí, cambian aquí (ver docs/PLAN-planes-premium.md).
const incluye = [
  { k: '0 %', v: 'de comisión con tus propios clientes, en cualquier plan' },
  { k: '10 % · 8 %', v: 'solo si además vendes en tu tienda de getcroquis (Profesional · Equipo)' },
  { k: '150 · 400', v: 'créditos de IA al mes (30 · 80 itinerarios); un 20 % más pagando el año' },
  { k: 'Tu marca', v: 'logo, colores, contacto y la firma de cada agente' },
  { k: 'Licencia ✓', v: 'sello de licencia verificada en tus itinerarios' },
  { k: '−20 · −25 %', v: 'en packs de créditos extra, precio de socio' },
];
const steps = [
  { n: '01', t: 'Solicita tu acceso', d: 'Validamos tu agencia y tu licencia: solo profesionales aprobados.' },
  { n: '02', t: 'Montamos tu agencia digital', d: 'Tu marca, tu escaparate y tus servicios listos en una tarde. Cero tecnicismos.' },
  { n: '03', t: 'Entregas con tu marca', d: 'Desde el primer día tus clientes reciben itinerarios tuyos, y además apareces en el buscador de getcroquis.' },
];
---

<Base title="getcroquis para agencias — digitaliza y capta clientes" description="Digitaliza tu agencia de viajes: itinerarios con IA y con tu marca en minutos, escaparate profesional, cobros seguros y CRM. Desde 24,92 € al mes pagando el año.">

  <!-- Selector de puerta (creador vs agencia) -->
  <div class="max-w-4xl mx-auto px-5 sm:px-6 pt-8 flex justify-center">
    <div class="inline-flex p-1 rounded-full bg-white/[0.05] border border-white/[0.1] text-sm font-semibold">
      <a href="/creadores" class="px-4 py-1.5 rounded-full text-white/55 hover:text-white transition">Creador o influencer</a>
      <span class="px-4 py-1.5 rounded-full bg-tirma-pink text-white">Agencia o profesional</span>
    </div>
  </div>

  <!-- HERO -->
  <section class="max-w-4xl mx-auto px-5 sm:px-6 pt-10 sm:pt-14 pb-6 text-center">
    <p class="reveal text-[11px] sm:text-xs font-semibold tracking-[0.22em] uppercase text-tirma-pink/80 mb-6">
      getcroquis para agencias
    </p>
    <h1 class="reveal text-[2.4rem] leading-[1.06] sm:text-[4rem] sm:leading-[1.03] font-extrabold tracking-[-0.03em]">
      Digitaliza tu agencia.<br class="hidden sm:block" />
      <span class="bg-gradient-to-r from-tirma-pink to-tirma-beige bg-clip-text text-transparent">Capta clientes de todo el mundo.</span>
    </h1>
    <p class="reveal mt-6 text-base sm:text-xl text-white/60 max-w-2xl mx-auto leading-relaxed">
      Itinerarios día a día con <strong class="text-white/80">tu marca</strong>, hechos en minutos con IA y revisados con tu criterio. Tu cliente lo lleva en el móvil todo el viaje.
    </p>
    <div class="reveal mt-9 flex flex-wrap gap-3 justify-center">
      <a href={`${SITE.appUrl}/creador?tipo=agencia`} class="px-8 py-3.5 rounded-full bg-tirma-pink text-white font-semibold shadow-xl shadow-tirma-pink/25 hover:bg-tirma-deep transition">
        Solicita tu acceso
      </a>
      <a href="#como-funciona" class="px-8 py-3.5 rounded-full border border-white/15 text-white/80 font-semibold hover:border-white/35 hover:text-white transition">
        Ver cómo funciona
      </a>
    </div>
    <p class="reveal mt-7 text-sm text-white/40 max-w-xl mx-auto">
      Pagas por la herramienta, no por tus clientes: con los tuyos, <strong class="text-white/65">0 % de comisión</strong>. Solo la cuota del plan.
    </p>
  </section>

  <!-- PRECIO (fuente: get_plan_features) -->
  <section class="max-w-4xl mx-auto px-5 sm:px-6 py-10 sm:py-14">
    <div class="reveal relative rounded-[2rem] overflow-hidden border border-tirma-pink/25 px-6 sm:px-10 py-10 sm:py-12">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-br from-tirma-pink/[0.12] via-transparent to-tirma-beige/[0.05]"></div>
      <div class="relative">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-tirma-pink/90 mb-2">Desde 24,92 € al mes</p>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-[-0.02em] mb-3">Un itinerario cobrado al mes ya lo paga.</h2>
        <p class="text-white/60 leading-relaxed max-w-2xl">
          Si cobras 30 € por el itinerario de un viaje que ya vendiste, con uno o dos al mes tienes la cuota cubierta. El resto es margen. Pagando el año, 2 meses gratis.
        </p>
      </div>
    </div>
  </section>

  <!-- QUÉ INCLUYE EL PLAN (números reales, sin letra pequeña) -->
  <section class="max-w-5xl mx-auto px-5 sm:px-6 pb-12 sm:pb-16">
    <div class="reveal max-w-2xl mb-8">
      <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-tirma-pink/80 mb-2">Qué incluye tu plan</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.02em]">Todo dentro, sin letra pequeña.</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px rounded-3xl overflow-hidden bg-white/[0.07] border border-white/[0.08]">
      {incluye.map((i) => (
        <div class="bg-[#0c1016] px-6 py-6">
          <div class="text-2xl font-extrabold text-tirma-beige tracking-[-0.03em]" style="font-variant-numeric:tabular-nums">{i.k}</div>
          <div class="text-sm text-white/50 mt-1 leading-relaxed">{i.v}</div>
        </div>
      ))}
    </div>
    <p class="reveal mt-6 text-sm text-white/45 max-w-2xl leading-relaxed">
      Los clientes que atiendes por tu cuenta son <strong class="text-white/70">100% tuyos</strong>: ahí no hay comisión, solo la cuota.
      La comisión (10 % o 8 % según el plan) aplica únicamente si además vendes dentro del marketplace de getcroquis.
    </p>

    <!-- Profesional vs Equipo (para una agencia no hay plan gratuito) -->
    <div class="reveal mt-10 grid sm:grid-cols-2 gap-4">
      <div class="rounded-3xl border border-white/[0.1] bg-white/[0.02] p-6 sm:p-7 flex flex-col">
        <div class="flex items-baseline justify-between gap-2 mb-1">
          <h3 class="text-lg font-bold">Profesional</h3>
          <span class="text-right">
            <span class="text-2xl font-extrabold text-white/85" style="font-variant-numeric:tabular-nums">29,90 €<span class="text-sm font-semibold text-white/40">/mes</span></span>
            <span class="block text-white/40 text-xs" style="font-variant-numeric:tabular-nums">o 299 €/año · 2 meses gratis</span>
          </span>
        </div>
        <p class="text-sm text-white/45 mb-5">Para la agencia de una persona o el asesor independiente.</p>
        <ul class="space-y-2.5 text-sm flex-1">
          <li class="flex gap-2.5"><span class="text-tirma-pink">✓</span><span class="text-white/75"><strong class="text-white">Tu marca</strong> y tu sello de licencia en cada itinerario</span></li>
          <li class="flex gap-2.5"><span class="text-tirma-pink">✓</span><span class="text-white/75"><strong class="text-white">150 créditos</strong> de IA al mes (180 pagando el año)</span></li>
          <li class="flex gap-2.5"><span class="text-tirma-pink">✓</span><span class="text-white/75"><strong class="text-white">0 %</strong> con tus clientes · 10 % en tu tienda</span></li>
          <li class="flex gap-2.5"><span class="text-tirma-pink">✓</span><span class="text-white/75">Packs de créditos <strong class="text-white">−20 %</strong></span></li>
        </ul>
      </div>

      <div class="relative rounded-3xl border border-tirma-pink/35 bg-gradient-to-b from-tirma-pink/[0.1] to-transparent p-6 sm:p-7 flex flex-col">
        <span class="absolute -top-2.5 left-6 text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-tirma-pink text-white">Para agencias con equipo</span>
        <div class="flex items-baseline justify-between gap-2 mb-1">
          <h3 class="text-lg font-bold">Equipo</h3>
          <span class="text-right">
            <span class="text-2xl font-extrabold text-tirma-beige" style="font-variant-numeric:tabular-nums">39,90 €<span class="text-sm font-semibold text-white/40">/mes</span></span>
            <span class="block text-white/40 text-xs" style="font-variant-numeric:tabular-nums">o 399 €/año · 2 meses gratis</span>
          </span>
        </div>
        <p class="text-sm text-white/45 mb-5">Todo el Profesional, para varios agentes.</p>
        <ul class="space-y-2.5 text-sm flex-1">
          <li class="flex gap-2.5"><span class="text-tirma-pink">✓</span><span class="text-white/80"><strong class="text-white">3 usuarios</strong>, cada uno con su firma <span class="text-[10px] font-bold uppercase tracking-wider text-tirma-pink">Próximamente</span></span></li>
          <li class="flex gap-2.5"><span class="text-tirma-pink">✓</span><span class="text-white/80"><strong class="text-white">400 créditos</strong> al mes para el equipo (480 pagando el año)</span></li>
          <li class="flex gap-2.5"><span class="text-tirma-pink">✓</span><span class="text-white/80"><strong class="text-white">0 %</strong> con tus clientes · solo <strong class="text-tirma-beige">8 %</strong> en tu tienda</span></li>
          <li class="flex gap-2.5"><span class="text-tirma-pink">✓</span><span class="text-white/80">Varias marcas y packs <strong class="text-white">−25 %</strong></span></li>
          <li class="flex gap-2.5"><span class="text-tirma-pink">✓</span><span class="text-white/80">Destacada en nuestras redes y <strong class="text-white">soporte prioritario</strong></span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- QUÉ TE LLEVAS -->
  <section class="max-w-6xl mx-auto px-5 sm:px-6 pb-16 sm:pb-24">
    <div class="reveal max-w-2xl mb-10">
      <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-tirma-pink/80 mb-2">Qué te llevas</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.02em]">Todo lo que necesita una agencia moderna, sin montar nada.</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {props.map((p, i) => (
        <div class="reveal p-7 rounded-3xl bg-white/[0.025] border border-white/[0.08]" style={`transition-delay:${(i % 3) * 70}ms`}>
          <h3 class="font-bold text-lg mb-2">{p.t}</h3>
          <p class="text-sm text-white/55 leading-relaxed">{p.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section id="como-funciona" class="max-w-5xl mx-auto px-5 sm:px-6 py-16 sm:py-24 border-t border-white/[0.06]">
    <div class="reveal max-w-2xl mb-12">
      <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-tirma-pink/80 mb-2">Cómo funciona</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.02em]">De tu solicitud a tu primer cliente, sin complicaciones.</h2>
    </div>
    <div class="grid sm:grid-cols-3 gap-x-10 gap-y-9">
      {steps.map((s) => (
        <div class="reveal">
          <div class="text-tirma-pink/50 font-bold text-sm mb-2" style="font-variant-numeric:tabular-nums">{s.n}</div>
          <h3 class="font-bold text-lg mb-1.5">{s.t}</h3>
          <p class="text-sm text-white/55 leading-relaxed">{s.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="max-w-4xl mx-auto px-5 sm:px-6 pb-24">
    <div class="reveal relative rounded-[2rem] overflow-hidden border border-white/[0.08] px-6 sm:px-12 py-14 sm:py-20 text-center">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-br from-tirma-pink/[0.14] via-transparent to-tirma-beige/[0.06]"></div>
      <div class="relative">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.02em]">Digitaliza tu agencia esta semana.</h2>
        <p class="text-white/55 mt-3 mb-8 max-w-md mx-auto">Solicitar es gratis y sin compromiso. Validamos cada agencia para que el sello signifique algo.</p>
        <a href={`${SITE.appUrl}/creador?tipo=agencia`} class="inline-block px-9 py-4 rounded-full bg-tirma-pink text-white font-semibold shadow-xl shadow-tirma-pink/25 hover:bg-tirma-deep transition">
          Solicita tu acceso
        </a>
        <p class="mt-5 text-sm text-white/40">¿Eres creador o influencer, no una agencia? <a href="/creadores" class="text-tirma-beige/80 hover:text-tirma-beige underline underline-offset-2">Tu puerta es esta →</a></p>
      </div>
    </div>
  </section>

  <script>
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</Base>
