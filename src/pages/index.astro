---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { COUNTRIES } from '../data/countries';
import { ITINERARIES, ITIN_GRADIENT } from '../data/itineraries';

const FEATURED: { slug: string; tagline: string }[] = [
  { slug: 'japon', tagline: 'El país del sol naciente' },
  { slug: 'italia', tagline: 'La dolce vita' },
  { slug: 'tailandia', tagline: 'El país de las sonrisas' },
  { slug: 'mexico', tagline: 'Color, ruinas y fiesta' },
  { slug: 'marruecos', tagline: 'Las puertas de África' },
  { slug: 'islandia', tagline: 'Hielo y fuego' },
];
const featured = FEATURED
  .map((f) => ({ ...f, c: COUNTRIES.find((x) => x.slug === f.slug) }))
  .filter((f) => f.c);

const count = COUNTRIES.length;
const stats = [
  { n: `${count}`, l: 'destinos a fondo' },
  { n: '5', l: 'continentes' },
  { n: '100%', l: 'a tu medida' },
  { n: 'Real', l: 'sin postureo' },
];

// Escaparate de itinerarios en la home (variedad geográfica).
const HOME_PICK = ['japon-clasico-10-dias', 'italia-romantica-6-dias', 'paris-5-dias', 'tailandia-9-dias', 'grecia-7-dias', 'marruecos-7-dias'];
const homeItins = HOME_PICK.map((s) => ITINERARIES.find((i) => i.slug === s)).filter(Boolean);
---

<Base>
  <!-- HERO -->
  <section class="max-w-4xl mx-auto px-5 sm:px-6 pt-12 sm:pt-20 pb-4 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-tirma-pink/10 border border-tirma-pink/25 text-tirma-beige/90 text-xs font-semibold mb-6">
      ✦ Sin postureo · gratis para empezar
    </div>
    <h1 class="text-4xl sm:text-6xl font-bold leading-[1.12] tracking-tight">
      Tu próximo viaje,<br />
      <span class="inline-block pb-1 bg-gradient-to-r from-tirma-pink to-tirma-beige bg-clip-text text-transparent">planificado en minutos</span>
    </h1>
    <p class="mt-5 text-base sm:text-lg text-white/70 max-w-xl mx-auto leading-relaxed">
      Se acabó perderte entre mil pestañas. Elige destino con <strong class="text-white/90">guías honestas y presupuesto real</strong>, y arma tu itinerario <strong class="text-white/90">día a día, 100% a tu medida</strong> —con la <strong class="text-white/90">IA</strong> cuando la quieras—. Copia viajes reales de otros viajeros y hazlos tuyos.
    </p>
    <div class="mt-8 flex flex-wrap gap-3 justify-center">
      <a href="/empezar" class="px-8 py-3.5 rounded-full bg-gradient-to-r from-tirma-pink to-tirma-deep text-tirma-beige font-bold shadow-lg shadow-tirma-pink/30 hover:brightness-105 transition">
        Empieza gratis →
      </a>
      <a href="/destinos" class="px-8 py-3.5 rounded-full border border-white/15 text-white/80 font-bold hover:border-tirma-pink/40 hover:text-white transition">
        Ver destinos
      </a>
    </div>
    <p class="mt-4 text-xs text-white/40">Sin registro para explorar · listo en minutos · sin tarjeta</p>
  </section>

  <!-- FRANJA DE CIFRAS -->
  <section class="max-w-3xl mx-auto px-5 sm:px-6 py-6">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      {stats.map((s) => (
        <div class="text-center rounded-2xl bg-white/[0.03] border border-white/[0.07] py-4">
          <div class="text-2xl sm:text-3xl font-black bg-gradient-to-r from-tirma-pink to-tirma-beige bg-clip-text text-transparent">{s.n}</div>
          <div class="text-[11px] sm:text-xs text-white/50 mt-1">{s.l}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- DESTINOS DESTACADOS (visual) -->
  <section class="max-w-5xl mx-auto px-5 sm:px-6 py-12 sm:py-16">
    <h2 class="text-2xl sm:text-3xl font-bold text-center">Destinos que enamoran</h2>
    <p class="text-center text-white/55 mt-2 mb-8 max-w-lg mx-auto">
      Guías completas de {count} países: clima mes a mes, presupuesto real, ciudades top y consejos sin postureo.
    </p>
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
      {featured.map((f) => (
        <a href={`/destinos/${f.slug}`} class="group relative rounded-2xl overflow-hidden aspect-[4/5] sm:aspect-square ring-1 ring-white/10">
          <img src={f.c!.image} alt={f.c!.name} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-110" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-3 sm:p-4">
            <div class="font-bold text-base sm:text-lg drop-shadow">{f.c!.name}</div>
            <div class="text-[11px] sm:text-xs text-tirma-beige/90 drop-shadow">{f.tagline}</div>
          </div>
        </a>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href="/destinos" class="inline-block px-7 py-3 rounded-full border border-white/15 text-white/80 font-bold hover:border-tirma-pink/40 hover:text-white transition">
        Explorar los {count} destinos 🌍
      </a>
    </div>
  </section>

  <!-- ITINERARIOS LISTOS (escaparate) -->
  <section class="max-w-5xl mx-auto px-5 sm:px-6 py-8 sm:py-12">
    <h2 class="text-2xl sm:text-3xl font-bold text-center">Itinerarios listos para inspirarte</h2>
    <p class="text-center text-white/55 mt-2 mb-8 max-w-lg mx-auto">
      Viajes reales, día a día. Cópialos y adáptalos <strong class="text-white/80">a tu medida</strong>: tus fechas, tu ritmo, tu estilo.
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
      {homeItins.map((it) => (
        <a href={`${SITE.appUrl}/getcroquis/${it!.slug}`} class="group relative rounded-2xl overflow-hidden aspect-[4/3] ring-1 ring-white/10 hover:ring-tirma-pink/50 transition">
          {it!.image
            ? <img src={it!.image} alt={it!.name} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-110" />
            : <div class="absolute inset-0" style={`background:${ITIN_GRADIENT}`}></div>}
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-transparent"></div>
          <span class="absolute top-2 right-2 text-[10px] font-bold bg-tirma-pink text-white px-2 py-0.5 rounded-full shadow opacity-0 group-hover:opacity-100 transition">Copiar →</span>
          <div class="absolute inset-x-0 bottom-0 p-3">
            <div class="font-bold text-white leading-tight drop-shadow">{it!.name}</div>
            <div class="text-[11px] text-white/85 drop-shadow">{it!.days} días · {it!.style}</div>
          </div>
        </a>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href={`${SITE.appUrl}/getcroquis`} class="inline-block px-7 py-3 rounded-full border border-white/15 text-white/80 font-bold hover:border-tirma-pink/40 hover:text-white transition">
        Ver todos los itinerarios →
      </a>
    </div>
  </section>

  <!-- 3 PASOS -->
  <section class="max-w-4xl mx-auto px-5 sm:px-6 py-10 sm:py-14">
    <h2 class="text-2xl sm:text-3xl font-bold text-center mb-8">Así funciona</h2>
    <div class="grid sm:grid-cols-3 gap-4 text-center">
      <div class="p-5 rounded-2xl bg-white/[0.03] border border-white/[0.08]">
        <div class="text-3xl mb-2">🧭</div>
        <h3 class="font-bold mb-1">1 · Elige destino</h3>
        <p class="text-sm text-white/55">Cuándo ir, presupuesto real y qué merece la pena (y qué no).</p>
      </div>
      <div class="p-5 rounded-2xl bg-white/[0.03] border border-white/[0.08]">
        <div class="text-3xl mb-2">✨</div>
        <h3 class="font-bold mb-1">2 · Diséñalo a tu medida</h3>
        <p class="text-sm text-white/55">Construye tu itinerario día a día, a tu gusto y 100% adaptado a ti. La IA te echa una mano cuando quieras.</p>
      </div>
      <div class="p-5 rounded-2xl bg-white/[0.03] border border-white/[0.08]">
        <div class="text-3xl mb-2">🌍</div>
        <h3 class="font-bold mb-1">3 · Comparte y descubre</h3>
        <p class="text-sm text-white/55">Copia itinerarios de otros viajeros o comparte el tuyo.</p>
      </div>
    </div>
    <div class="text-center mt-10">
      <p class="text-lg font-bold mb-1">¿Listo para tu próximo viaje?</p>
      <p class="text-sm text-white/50 mb-5">Crea tu cuenta y empieza a planificar hoy.</p>
      <a href={`${SITE.appUrl}/signup`} class="inline-block px-8 py-3.5 rounded-full bg-gradient-to-r from-tirma-pink to-tirma-deep text-tirma-beige font-bold shadow-lg shadow-tirma-pink/25 hover:brightness-105 transition">
        Crear mi cuenta →
      </a>
    </div>
  </section>
</Base>
