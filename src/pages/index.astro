---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { COUNTRIES } from '../data/countries';
import { ITINERARIES, ITIN_GRADIENT } from '../data/itineraries';

const FEATURED: { slug: string; tagline: string }[] = [
  { slug: 'japon', tagline: 'El país del sol naciente' },
  { slug: 'italia', tagline: 'La dolce vita' },
  { slug: 'tailandia', tagline: 'El país de las sonrisas' },
  { slug: 'mexico', tagline: 'Color, ruinas y fiesta' },
  { slug: 'marruecos', tagline: 'Las puertas de África' },
  { slug: 'islandia', tagline: 'Hielo y fuego' },
];
const featured = FEATURED
  .map((f) => ({ ...f, c: COUNTRIES.find((x) => x.slug === f.slug) }))
  .filter((f) => f.c);

const count = COUNTRIES.length;
const stats = [
  { n: `${count}`, l: 'destinos a fondo' },
  { n: '5', l: 'continentes' },
  { n: 'IA', l: 'tu plan en segundos' },
  { n: '100%', l: 'a tu medida' },
];

// Escaparate de itinerarios en la home (variedad geográfica).
const HOME_PICK = ['tenerife-5-dias', 'peru-7-dias', 'islandia-6-dias', 'vietnam-8-dias', 'japon-clasico-10-dias', 'italia-romantica-6-dias'];
const homeItins = HOME_PICK.map((s) => ITINERARIES.find((i) => i.slug === s)).filter(Boolean);
---

<Base>
  <!-- HERO editorial -->
  <section class="max-w-4xl mx-auto px-5 sm:px-6 pt-16 sm:pt-28 pb-6 text-center">
    <p class="reveal text-[11px] sm:text-xs font-semibold tracking-[0.22em] uppercase text-white/40 mb-6">
      Planificador · Comunidad · Marketplace
    </p>
    <h1 class="reveal text-[2.6rem] leading-[1.05] sm:text-[4.5rem] sm:leading-[1.02] font-extrabold tracking-[-0.03em]">
      Tu próximo viaje,<br class="hidden sm:block" />
      <span class="bg-gradient-to-r from-tirma-pink to-tirma-beige bg-clip-text text-transparent">bien planificado.</span>
    </h1>
    <p class="reveal mt-6 text-base sm:text-xl text-white/60 max-w-2xl mx-auto leading-relaxed">
      Diseña tu itinerario día a día con ayuda de la IA, inspírate en viajes reales de otros viajeros
      y descubre a los creadores que hacen de sus rutas una experiencia.
    </p>
    <div class="reveal mt-9 flex flex-wrap gap-3 justify-center">
      <a href="/empezar" class="px-8 py-3.5 rounded-full bg-tirma-pink text-white font-semibold shadow-xl shadow-tirma-pink/25 hover:bg-tirma-deep transition">
        Crea tu viaje
      </a>
      <a href="/destinos" class="px-8 py-3.5 rounded-full border border-white/15 text-white/80 font-semibold hover:border-white/35 hover:text-white transition">
        Explorar destinos
      </a>
    </div>
    <p class="reveal mt-5 text-xs text-white/35">Sin registro para explorar · listo en minutos</p>

    <!-- Cifras: limpias, sin degradado (una sola pieza sobria) -->
    <div class="reveal mt-14 sm:mt-20 grid grid-cols-2 sm:grid-cols-4 gap-px rounded-2xl overflow-hidden bg-white/[0.06] border border-white/[0.07]">
      {stats.map((s) => (
        <div class="bg-[#0c1016] py-5 px-3 text-center">
          <div class="text-2xl sm:text-3xl font-bold text-tirma-beige">{s.n}</div>
          <div class="text-[11px] sm:text-xs text-white/45 mt-1">{s.l}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- DESTINOS (la fotografía manda) -->
  <section class="max-w-6xl mx-auto px-5 sm:px-6 py-16 sm:py-24">
    <div class="reveal flex items-end justify-between gap-4 mb-8">
      <div>
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-tirma-pink/80 mb-2">Destinos</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.02em]">Dónde ir, sin postureo</h2>
      </div>
      <a href="/destinos" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-white/60 hover:text-white transition whitespace-nowrap">
        Ver los {count} destinos
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
      {featured.map((f) => (
        <a href={`/destinos/${f.slug}`} class="reveal group relative rounded-3xl overflow-hidden aspect-[4/5] sm:aspect-[4/3] ring-1 ring-white/10">
          <img src={f.c!.image} alt={f.c!.name} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition duration-700 ease-out group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-4 sm:p-5">
            <div class="font-bold text-lg sm:text-xl tracking-tight drop-shadow">{f.c!.name}</div>
            <div class="text-xs text-white/70 drop-shadow mt-0.5">{f.tagline}</div>
          </div>
        </a>
      ))}
    </div>
    <div class="sm:hidden text-center mt-7">
      <a href="/destinos" class="inline-block px-7 py-3 rounded-full border border-white/15 text-white/80 font-semibold hover:border-white/35 transition">
        Ver los {count} destinos
      </a>
    </div>
  </section>

  <!-- ITINERARIOS LISTOS -->
  <section class="max-w-6xl mx-auto px-5 sm:px-6 pb-16 sm:pb-24">
    <div class="reveal flex items-end justify-between gap-4 mb-8">
      <div>
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-tirma-pink/80 mb-2">Inspiración</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.02em]">Itinerarios listos para copiar</h2>
        <p class="text-white/50 mt-2 max-w-md">Viajes reales, día a día. Cópialos y adáptalos a tus fechas, tu ritmo y tu estilo.</p>
      </div>
      <a href={`${SITE.appUrl}/getcroquis`} class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-white/60 hover:text-white transition whitespace-nowrap">
        Ver todos
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
      {homeItins.map((it) => (
        <a href={`${SITE.appUrl}/getcroquis/${it!.slug}`} class="reveal group relative rounded-3xl overflow-hidden aspect-[4/3] ring-1 ring-white/10 hover:ring-tirma-pink/40 transition">
          {it!.image
            ? <img src={it!.image} alt={it!.name} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition duration-700 ease-out group-hover:scale-105" />
            : <div class="absolute inset-0" style={`background:${ITIN_GRADIENT}`}></div>}
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-4">
            <div class="font-bold text-white leading-tight tracking-tight drop-shadow">{it!.name}</div>
            <div class="text-xs text-white/70 drop-shadow mt-0.5">{it!.days} días · {it!.style}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- MARKETPLACE DE CREADORES -->
  <section class="max-w-6xl mx-auto px-5 sm:px-6 py-16 sm:py-24">
    <div class="reveal max-w-2xl mb-12">
      <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-tirma-pink/80 mb-2">Nuevo · Marketplace</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.02em]">Viaja con tus creadores favoritos</h2>
      <p class="text-white/55 mt-3 leading-relaxed">
        Creadores de viajes y agencias comparten aquí lo que no cabe en un post: sus rutas completas
        y su disponibilidad real durante tu viaje.
      </p>
    </div>
    <div class="grid sm:grid-cols-3 gap-4">
      <div class="reveal p-7 rounded-3xl bg-white/[0.025] border border-white/[0.08] hover:border-white/[0.16] transition duration-300">
        <span class="inline-flex w-11 h-11 items-center justify-center rounded-xl bg-tirma-pink/10 border border-tirma-pink/20 text-tirma-pink mb-5">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </span>
        <h3 class="font-bold text-lg mb-2">Catálogos premium</h3>
        <p class="text-sm text-white/55 leading-relaxed">Un solo pago desbloquea para siempre todos los itinerarios de un creador: día a día, horarios, mapas y sus sitios de verdad.</p>
      </div>
      <div class="reveal p-7 rounded-3xl bg-white/[0.025] border border-white/[0.08] hover:border-white/[0.16] transition duration-300" style="transition-delay:70ms">
        <span class="inline-flex w-11 h-11 items-center justify-center rounded-xl bg-tirma-pink/10 border border-tirma-pink/20 text-tirma-pink mb-5">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
        </span>
        <h3 class="font-bold text-lg mb-2">Asistencia en tu viaje</h3>
        <p class="text-sm text-white/55 leading-relaxed">Contrata al creador o a la agencia y tenlos a un mensaje durante tu viaje, con idiomas y horarios claros antes de pagar.</p>
      </div>
      <div class="reveal p-7 rounded-3xl bg-white/[0.025] border border-white/[0.08] hover:border-white/[0.16] transition duration-300" style="transition-delay:140ms">
        <span class="inline-flex w-11 h-11 items-center justify-center rounded-xl bg-tirma-pink/10 border border-tirma-pink/20 text-tirma-pink mb-5">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 7h6v6"/><path d="m22 7-8.5 8.5-5-5L2 17"/></svg>
        </span>
        <h3 class="font-bold text-lg mb-2">¿Creas contenido de viajes?</h3>
        <p class="text-sm text-white/55 leading-relaxed">Convierte tu audiencia en ingresos: comparte tus itinerarios y servicios, con cobros automáticos y sin complicaciones.</p>
      </div>
    </div>
    <div class="reveal mt-9">
      <a href={`${SITE.appUrl}/creador`} class="inline-block px-8 py-3.5 rounded-full bg-tirma-pink text-white font-semibold shadow-xl shadow-tirma-pink/25 hover:bg-tirma-deep transition">
        Empieza a vender tus viajes
      </a>
    </div>
  </section>

  <!-- ASÍ FUNCIONA -->
  <section class="max-w-5xl mx-auto px-5 sm:px-6 py-16 sm:py-24 border-t border-white/[0.06]">
    <p class="reveal text-[11px] font-semibold tracking-[0.18em] uppercase text-tirma-pink/80 mb-2 text-center">Cómo funciona</p>
    <h2 class="reveal text-3xl sm:text-4xl font-bold tracking-[-0.02em] text-center mb-12">Tres pasos, y a hacer la maleta</h2>
    <div class="grid sm:grid-cols-3 gap-8 sm:gap-6">
      <div class="reveal text-center sm:text-left">
        <div class="text-tirma-pink/50 font-bold text-sm mb-3">01</div>
        <h3 class="font-bold text-lg mb-1.5">Elige destino</h3>
        <p class="text-sm text-white/55 leading-relaxed">Cuándo ir, presupuesto real y qué merece la pena. Guías honestas de {count} países.</p>
      </div>
      <div class="reveal text-center sm:text-left" style="transition-delay:70ms">
        <div class="text-tirma-pink/50 font-bold text-sm mb-3">02</div>
        <h3 class="font-bold text-lg mb-1.5">Diséñalo a tu medida</h3>
        <p class="text-sm text-white/55 leading-relaxed">Tu itinerario día a día, 100% adaptado a ti. La IA te echa una mano cuando la quieras.</p>
      </div>
      <div class="reveal text-center sm:text-left" style="transition-delay:140ms">
        <div class="text-tirma-pink/50 font-bold text-sm mb-3">03</div>
        <h3 class="font-bold text-lg mb-1.5">Descubre, copia y viaja</h3>
        <p class="text-sm text-white/55 leading-relaxed">Sigue a viajeros y creadores, copia rutas gratis y desbloquea las premium con su asistencia.</p>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="max-w-4xl mx-auto px-5 sm:px-6 pb-24">
    <div class="reveal relative rounded-[2rem] overflow-hidden border border-white/[0.08] px-6 sm:px-12 py-14 sm:py-20 text-center">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-br from-tirma-pink/[0.12] via-transparent to-tirma-beige/[0.06]"></div>
      <div class="relative">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.02em]">¿Listo para tu próximo viaje?</h2>
        <p class="text-white/55 mt-3 mb-8 max-w-md mx-auto">Crea tu cuenta gratis y ten tu primer itinerario listo hoy.</p>
        <a href={`${SITE.appUrl}/signup`} class="inline-block px-9 py-4 rounded-full bg-tirma-pink text-white font-semibold shadow-xl shadow-tirma-pink/25 hover:bg-tirma-deep transition">
          Crear mi cuenta
        </a>
      </div>
    </div>
  </section>

  <script>
    // Aparición suave de cada elemento .reveal al entrar en pantalla.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</Base>
