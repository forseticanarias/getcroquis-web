---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { COUNTRIES } from '../data/countries';
import { ITINERARIES, ITIN_GRADIENT } from '../data/itineraries';

const FEATURED: { slug: string; tagline: string }[] = [
  { slug: 'japon', tagline: 'El país del sol naciente' },
  { slug: 'italia', tagline: 'La dolce vita' },
  { slug: 'tailandia', tagline: 'El país de las sonrisas' },
  { slug: 'mexico', tagline: 'Color, ruinas y fiesta' },
  { slug: 'marruecos', tagline: 'Las puertas de África' },
  { slug: 'islandia', tagline: 'Hielo y fuego' },
];
const featured = FEATURED
  .map((f) => ({ ...f, c: COUNTRIES.find((x) => x.slug === f.slug) }))
  .filter((f) => f.c);

const count = COUNTRIES.length;
const stats = [
  { n: `${count}`, l: 'destinos a fondo' },
  { n: '5', l: 'continentes' },
  { n: 'IA', l: 'tu plan en segundos' },
  { n: '85%', l: 'para el creador en cada venta' },
];

// Carrusel infinito de fotos (efecto visual del hero): destinos con imagen.
const marquee = COUNTRIES.filter((c) => c.image).slice(0, 14);

// Escaparate de itinerarios en la home (variedad geográfica).
const HOME_PICK = ['tenerife-5-dias', 'peru-7-dias', 'islandia-6-dias', 'vietnam-8-dias', 'japon-clasico-10-dias', 'italia-romantica-6-dias'];
const homeItins = HOME_PICK.map((s) => ITINERARIES.find((i) => i.slug === s)).filter(Boolean);
---

<Base>
  <!-- HERO (con brillos de fondo sutiles) -->
  <section class="relative max-w-4xl mx-auto px-5 sm:px-6 pt-12 sm:pt-20 pb-4 text-center overflow-visible">
    <!-- Orbes de luz: profundidad sin ruido -->
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-24 w-72 h-72 rounded-full bg-tirma-pink/20 blur-[110px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute top-24 -right-24 w-80 h-80 rounded-full bg-tirma-deep/25 blur-[120px]"></div>

    <div class="reveal inline-flex items-center gap-2 px-3 py-1 rounded-full bg-tirma-pink/10 border border-tirma-pink/25 text-tirma-beige/90 text-xs font-semibold mb-6">
      ✦ Planifica con IA · Descubre viajeros · Compra a tus creadores
    </div>
    <h1 class="reveal text-4xl sm:text-6xl font-bold leading-[1.12] tracking-tight">
      Tu próximo viaje,<br />
      <span class="inline-block pb-1 bg-gradient-to-r from-tirma-pink to-tirma-beige bg-clip-text text-transparent">planificado en minutos</span>
    </h1>
    <p class="reveal mt-5 text-base sm:text-lg text-white/70 max-w-xl mx-auto leading-relaxed">
      Se acabó perderte entre mil pestañas. Arma tu itinerario <strong class="text-white/90">día a día con IA</strong>, copia viajes reales de otros viajeros… y ve más allá: <strong class="text-white/90">desbloquea los itinerarios premium de tus creadores favoritos</strong> y viaja con <strong class="text-white/90">su asistencia directa</strong> en el bolsillo.
    </p>
    <div class="reveal mt-8 flex flex-wrap gap-3 justify-center">
      <a href="/empezar" class="px-8 py-3.5 rounded-full bg-gradient-to-r from-tirma-pink to-tirma-deep text-tirma-beige font-bold shadow-lg shadow-tirma-pink/30 hover:brightness-105 hover:scale-[1.02] transition">
        Crea tu viaje →
      </a>
      <a href="/destinos" class="px-8 py-3.5 rounded-full border border-white/15 text-white/80 font-bold hover:border-tirma-pink/40 hover:text-white transition">
        Ver destinos
      </a>
    </div>
    <p class="reveal mt-4 text-xs text-white/40">Explora sin registro · listo en minutos</p>
  </section>

  <!-- CARRUSEL INFINITO de destinos (puro CSS, sin JS): el mundo pasando -->
  <section aria-hidden="true" class="mt-8 sm:mt-10 overflow-hidden select-none" style="mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);">
    <div class="marquee flex gap-3 w-max">
      {[...marquee, ...marquee].map((c) => (
        <a href={`/destinos/${c.slug}`} tabindex="-1" class="relative w-40 h-24 sm:w-52 sm:h-32 rounded-xl overflow-hidden ring-1 ring-white/10 flex-shrink-0 group">
          <img src={c.image} alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-110" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
          <span class="absolute bottom-1.5 left-2.5 text-xs font-bold drop-shadow">{c.name}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- FRANJA DE CIFRAS -->
  <section class="max-w-3xl mx-auto px-5 sm:px-6 py-6">
    <div class="reveal grid grid-cols-2 sm:grid-cols-4 gap-3">
      {stats.map((s) => (
        <div class="text-center rounded-2xl bg-white/[0.03] border border-white/[0.07] py-4">
          <div class="text-2xl sm:text-3xl font-black bg-gradient-to-r from-tirma-pink to-tirma-beige bg-clip-text text-transparent">{s.n}</div>
          <div class="text-[11px] sm:text-xs text-white/50 mt-1">{s.l}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- DESTINOS DESTACADOS (visual) -->
  <section class="max-w-5xl mx-auto px-5 sm:px-6 py-12 sm:py-16">
    <h2 class="reveal text-2xl sm:text-3xl font-bold text-center">Destinos que enamoran</h2>
    <p class="reveal text-center text-white/55 mt-2 mb-8 max-w-lg mx-auto">
      Guías completas de {count} países: clima mes a mes, presupuesto real, ciudades top y consejos sin postureo.
    </p>
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
      {featured.map((f) => (
        <a href={`/destinos/${f.slug}`} class="group relative rounded-2xl overflow-hidden aspect-[4/5] sm:aspect-square ring-1 ring-white/10">
          <img src={f.c!.image} alt={f.c!.name} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-110" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-3 sm:p-4">
            <div class="font-bold text-base sm:text-lg drop-shadow">{f.c!.name}</div>
            <div class="text-[11px] sm:text-xs text-tirma-beige/90 drop-shadow">{f.tagline}</div>
          </div>
        </a>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href="/destinos" class="inline-block px-7 py-3 rounded-full border border-white/15 text-white/80 font-bold hover:border-tirma-pink/40 hover:text-white transition">
        Explorar los {count} destinos 🌍
      </a>
    </div>
  </section>

  <!-- ITINERARIOS LISTOS (escaparate) -->
  <section class="max-w-5xl mx-auto px-5 sm:px-6 py-8 sm:py-12">
    <h2 class="reveal text-2xl sm:text-3xl font-bold text-center">Itinerarios listos para inspirarte</h2>
    <p class="reveal text-center text-white/55 mt-2 mb-8 max-w-lg mx-auto">
      Viajes reales, día a día. Cópialos y adáptalos <strong class="text-white/80">a tu medida</strong>: tus fechas, tu ritmo, tu estilo.
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
      {homeItins.map((it) => (
        <a href={`${SITE.appUrl}/getcroquis/${it!.slug}`} class="group relative rounded-2xl overflow-hidden aspect-[4/3] ring-1 ring-white/10 hover:ring-tirma-pink/50 transition">
          {it!.image
            ? <img src={it!.image} alt={it!.name} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-110" />
            : <div class="absolute inset-0" style={`background:${ITIN_GRADIENT}`}></div>}
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-transparent"></div>
          <span class="absolute top-2 right-2 text-[10px] font-bold bg-tirma-pink text-white px-2 py-0.5 rounded-full shadow opacity-0 group-hover:opacity-100 transition">Copiar →</span>
          <div class="absolute inset-x-0 bottom-0 p-3">
            <div class="font-bold text-white leading-tight drop-shadow">{it!.name}</div>
            <div class="text-[11px] text-white/85 drop-shadow">{it!.days} días · {it!.style}</div>
          </div>
        </a>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href={`${SITE.appUrl}/getcroquis`} class="inline-block px-7 py-3 rounded-full border border-white/15 text-white/80 font-bold hover:border-tirma-pink/40 hover:text-white transition">
        Ver todos los itinerarios →
      </a>
    </div>
  </section>

  <!-- MARKETPLACE DE CREADORES (el nuevo enfoque) -->
  <section class="relative max-w-5xl mx-auto px-5 sm:px-6 py-12 sm:py-16 overflow-visible">
    <div aria-hidden="true" class="pointer-events-none absolute top-10 left-1/2 -translate-x-1/2 w-[28rem] h-72 rounded-full bg-tirma-pink/10 blur-[130px]"></div>
    <div class="reveal text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-tirma-pink/10 border border-tirma-pink/25 text-tirma-beige/90 text-xs font-semibold mb-4">
        ✨ Nuevo · Marketplace de creadores
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold">Viaja con tus creadores favoritos</h2>
      <p class="text-white/55 mt-2 mb-10 max-w-xl mx-auto">
        Influencers de viajes y agencias venden aquí lo que no cabe en un post: sus rutas completas y su
        <strong class="text-white/80"> disponibilidad real</strong> durante tu viaje.
      </p>
    </div>
    <div class="grid sm:grid-cols-3 gap-4">
      <div class="reveal p-6 rounded-2xl bg-white/[0.03] border border-white/[0.08] hover:border-tirma-pink/30 hover:-translate-y-1 transition duration-300">
        <div class="text-3xl mb-3">🔒</div>
        <h3 class="font-bold mb-1.5">Catálogos premium</h3>
        <p class="text-sm text-white/55 leading-relaxed">Un solo pago desbloquea <strong class="text-white/75">para siempre</strong> todos los itinerarios premium de un creador: día a día, horarios, mapas y sus sitios de verdad.</p>
      </div>
      <div class="reveal p-6 rounded-2xl bg-white/[0.03] border border-white/[0.08] hover:border-tirma-pink/30 hover:-translate-y-1 transition duration-300" style="transition-delay: 60ms">
        <div class="text-3xl mb-3">💬</div>
        <h3 class="font-bold mb-1.5">Asistencia en tu viaje</h3>
        <p class="text-sm text-white/55 leading-relaxed">Contrata al creador o a la agencia y tenlos <strong class="text-white/75">en tu WhatsApp, Telegram o Discord</strong> durante el viaje — idiomas y horarios claros antes de pagar.</p>
      </div>
      <div class="reveal p-6 rounded-2xl bg-white/[0.03] border border-white/[0.08] hover:border-tirma-pink/30 hover:-translate-y-1 transition duration-300" style="transition-delay: 120ms">
        <div class="text-3xl mb-3">💶</div>
        <h3 class="font-bold mb-1.5">¿Creas contenido de viajes?</h3>
        <p class="text-sm text-white/55 leading-relaxed">Convierte tu audiencia en ingresos: vende tus itinerarios y servicios con <strong class="text-white/75">el 85% de cada venta</strong> para ti, cobros automáticos y cero líos.</p>
      </div>
    </div>
    <div class="reveal text-center mt-8">
      <a href={`${SITE.appUrl}/creador`} class="inline-block px-7 py-3 rounded-full bg-gradient-to-r from-tirma-pink to-tirma-deep text-tirma-beige font-bold shadow-lg shadow-tirma-pink/25 hover:brightness-105 hover:scale-[1.02] transition">
        Hazte creador ✨
      </a>
    </div>
  </section>

  <!-- 3 PASOS -->
  <section class="max-w-4xl mx-auto px-5 sm:px-6 py-10 sm:py-14">
    <h2 class="reveal text-2xl sm:text-3xl font-bold text-center mb-8">Así funciona</h2>
    <div class="grid sm:grid-cols-3 gap-4 text-center">
      <div class="reveal p-5 rounded-2xl bg-white/[0.03] border border-white/[0.08]">
        <div class="text-3xl mb-2">🧭</div>
        <h3 class="font-bold mb-1">1 · Elige destino</h3>
        <p class="text-sm text-white/55">Cuándo ir, presupuesto real y qué merece la pena (y qué no).</p>
      </div>
      <div class="reveal p-5 rounded-2xl bg-white/[0.03] border border-white/[0.08]" style="transition-delay: 60ms">
        <div class="text-3xl mb-2">✨</div>
        <h3 class="font-bold mb-1">2 · Diséñalo a tu medida</h3>
        <p class="text-sm text-white/55">Construye tu itinerario día a día, a tu gusto y 100% adaptado a ti. La IA te echa una mano cuando quieras.</p>
      </div>
      <div class="reveal p-5 rounded-2xl bg-white/[0.03] border border-white/[0.08]" style="transition-delay: 120ms">
        <div class="text-3xl mb-2">🌍</div>
        <h3 class="font-bold mb-1">3 · Descubre, copia y compra</h3>
        <p class="text-sm text-white/55">Sigue a viajeros y creadores: copia itinerarios gratis, desbloquea los premium y viaja con su asistencia.</p>
      </div>
    </div>
    <div class="reveal text-center mt-10">
      <p class="text-lg font-bold mb-1">¿Listo para tu próximo viaje?</p>
      <p class="text-sm text-white/50 mb-5">Crea tu cuenta y empieza a planificar hoy.</p>
      <a href={`${SITE.appUrl}/signup`} class="inline-block px-8 py-3.5 rounded-full bg-gradient-to-r from-tirma-pink to-tirma-deep text-tirma-beige font-bold shadow-lg shadow-tirma-pink/25 hover:brightness-105 hover:scale-[1.02] transition">
        Crear mi cuenta →
      </a>
    </div>
  </section>

  <!-- Efectos: carrusel infinito + aparición al hacer scroll -->
  <style is:global>
    @keyframes gc-marquee {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
    .marquee { animation: gc-marquee 55s linear infinite; }
    .marquee:hover { animation-play-state: paused; }

    .reveal { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; }
    .reveal.in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) {
      .marquee { animation: none; }
      .reveal { opacity: 1; transform: none; transition: none; }
    }
  </style>
  <script>
    // Aparición suave al entrar en pantalla (una sola vez por elemento).
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</Base>
