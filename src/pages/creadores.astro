---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';

const stats = [
  { n: '85%', l: 'de cada venta es para ti' },
  { n: 'Tú', l: 'pones el precio' },
  { n: 'Auto', l: 'cobros con Stripe' },
  { n: '0 €', l: 'de alta, sin cuotas' },
];
const steps = [
  { n: '01', t: 'Solicita ser creador', d: 'Rellenas tu perfil y pides acceso. Solo creadores aprobados venden.' },
  { n: '02', t: 'Monta tu tienda', d: 'Itinerarios premium con precio + tus servicios. Panel sencillo.' },
  { n: '03', t: 'Comparte con tu audiencia', d: 'Tu escaparate se ve sin registro: para tu bio y tus stories.' },
  { n: '04', t: 'Cobra, automático', d: 'El 85% cae directo en tu Stripe. Sin facturas ni perseguir a nadie.' },
];
const forWho = [
  { t: 'Influencers de viajes', d: 'Convierte los "¿me pasas tu itinerario?" en ingresos.' },
  { t: 'Guías locales', d: 'Vende tu conocimiento del destino y tu acompañamiento.' },
  { t: 'Blogueros y fotógrafos', d: 'Rentabiliza tu contenido y tus rutas con tu marca.' },
];

// Las piezas que cada creador combina a su gusto. Solo el catálogo es la
// base; el resto es opcional. Cualquiera —influencer, guía o agencia— puede
// ofrecer una, dos o todas.
const services = [
  { name: 'Catálogo premium', tag: 'La base', d: 'Tus itinerarios con candado. Un pago desbloquea todo tu catálogo para siempre.' },
  { name: 'Sesión de planificación', tag: 'Opcional', d: 'Videollamada 1:1 para diseñar el viaje a medida. Tú pones precio y horario.' },
  { name: 'Asistencia en viaje', tag: 'Opcional', d: 'A un mensaje durante el viaje (WhatsApp, Telegram, Discord), a tu disponibilidad.' },
];
---

<Base title="Vende tus viajes — getcroquis para creadores" description="Convierte tu audiencia en ingresos: vende tus itinerarios y tu asistencia en viaje con getcroquis. El 85% de cada venta es para ti, cobros automáticos y sin cuotas de alta.">

  <!-- Selector de puerta (creador vs agencia) -->
  <div class="max-w-4xl mx-auto px-5 sm:px-6 pt-8 flex justify-center">
    <div class="inline-flex p-1 rounded-full bg-white/[0.05] border border-white/[0.1] text-sm font-semibold">
      <span class="px-4 py-1.5 rounded-full bg-tirma-pink text-white">Creador o influencer</span>
      <a href="/agencias" class="px-4 py-1.5 rounded-full text-white/55 hover:text-white transition">Agencia o profesional</a>
    </div>
  </div>

  <!-- HERO -->
  <section class="max-w-4xl mx-auto px-5 sm:px-6 pt-10 sm:pt-14 pb-6 text-center">
    <p class="reveal text-[11px] sm:text-xs font-semibold tracking-[0.22em] uppercase text-tirma-pink/80 mb-6">
      getcroquis para creadores
    </p>
    <h1 class="reveal text-[2.6rem] leading-[1.05] sm:text-[4.2rem] sm:leading-[1.02] font-extrabold tracking-[-0.03em]">
      Convierte tus viajes<br class="hidden sm:block" />
      <span class="bg-gradient-to-r from-tirma-pink to-tirma-beige bg-clip-text text-transparent">en ingresos.</span>
    </h1>
    <p class="reveal mt-6 text-base sm:text-xl text-white/60 max-w-2xl mx-auto leading-relaxed">
      Tu audiencia ya te pregunta "¿me pasas tu itinerario?". Véndeselo bien hecho y acompáñalos en el viaje. Tú pones el precio; el 85% es para ti.
    </p>
    <div class="reveal mt-9 flex flex-wrap gap-3 justify-center">
      <a href={`${SITE.appUrl}/creador?tipo=creador`} class="px-8 py-3.5 rounded-full bg-tirma-pink text-white font-semibold shadow-xl shadow-tirma-pink/25 hover:bg-tirma-deep transition">
        Hazte creador
      </a>
      <a href="#como-funciona" class="px-8 py-3.5 rounded-full border border-white/15 text-white/80 font-semibold hover:border-white/35 hover:text-white transition">
        Ver cómo funciona
      </a>
    </div>

    <div class="reveal mt-14 sm:mt-20 grid grid-cols-2 sm:grid-cols-4 gap-px rounded-2xl overflow-hidden bg-white/[0.06] border border-white/[0.07]">
      {stats.map((s) => (
        <div class="bg-[#0c1016] py-5 px-3 text-center">
          <div class="text-2xl sm:text-3xl font-bold text-tirma-beige">{s.n}</div>
          <div class="text-[11px] sm:text-xs text-white/45 mt-1">{s.l}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- LA OPORTUNIDAD -->
  <section class="max-w-6xl mx-auto px-5 sm:px-6 py-16 sm:py-24">
    <div class="reveal max-w-2xl mb-10">
      <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-tirma-pink/80 mb-2">La oportunidad</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.02em]">Ya tienes lo más difícil: gente que te escucha.</h2>
    </div>
    <div class="grid sm:grid-cols-3 gap-4">
      <div class="reveal p-7 rounded-3xl bg-white/[0.025] border border-white/[0.08]">
        <span class="inline-flex w-11 h-11 items-center justify-center rounded-xl bg-tirma-pink/10 border border-tirma-pink/20 text-tirma-pink mb-5">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
        <h3 class="font-bold text-lg mb-2">Tu audiencia, tu activo</h3>
        <p class="text-sm text-white/55 leading-relaxed">Vendes a quien ya confía en ti. No dependes de que te descubran.</p>
      </div>
      <div class="reveal p-7 rounded-3xl bg-white/[0.025] border border-white/[0.08]" style="transition-delay:70ms">
        <span class="inline-flex w-11 h-11 items-center justify-center rounded-xl bg-tirma-pink/10 border border-tirma-pink/20 text-tirma-pink mb-5">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 7h6v6"/><path d="m22 7-8.5 8.5-5-5L2 17"/></svg>
        </span>
        <h3 class="font-bold text-lg mb-2">El 85% es tuyo</h3>
        <p class="text-sm text-white/55 leading-relaxed">Tú pones el precio y te quedas el 85%. Solo cobramos cuando tú cobras.</p>
      </div>
      <div class="reveal p-7 rounded-3xl bg-white/[0.025] border border-white/[0.08]" style="transition-delay:140ms">
        <span class="inline-flex w-11 h-11 items-center justify-center rounded-xl bg-tirma-pink/10 border border-tirma-pink/20 text-tirma-pink mb-5">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </span>
        <h3 class="font-bold text-lg mb-2">Las herramientas, hechas</h3>
        <p class="text-sm text-white/55 leading-relaxed">Cobros, catálogo, asistencia por chat, estadísticas… La fontanería la ponemos nosotros.</p>
      </div>
    </div>
  </section>

  <!-- QUÉ VENDES -->
  <section class="max-w-6xl mx-auto px-5 sm:px-6 pb-16 sm:pb-24">
    <div class="reveal max-w-2xl mb-10">
      <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-tirma-pink/80 mb-2">Qué vendes</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.02em]">Dos formas de monetizar lo que ya sabes.</h2>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="reveal p-8 rounded-3xl bg-gradient-to-b from-white/[0.04] to-transparent border border-white/[0.1]">
        <h3 class="font-bold text-xl mb-2">Tu catálogo premium</h3>
        <p class="text-white/60 leading-relaxed">La portada engancha y un pago desbloquea todo tu catálogo para siempre: día a día, horarios, mapas y tus sitios de verdad. Tú decides el precio.</p>
      </div>
      <div class="reveal p-8 rounded-3xl bg-gradient-to-b from-white/[0.04] to-transparent border border-white/[0.1]" style="transition-delay:70ms">
        <h3 class="font-bold text-xl mb-2 inline-flex items-center gap-2">Tu asistencia en viaje
          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-white/[0.06] border border-white/[0.12] text-white/50">Opcional</span>
        </h3>
        <p class="text-white/60 leading-relaxed">Lo que no cabe en un post: acompañamiento real. Sesión de planificación, guía en destino o estar a un mensaje durante el viaje. Idiomas y horarios claros antes de contratar.</p>
      </div>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section id="como-funciona" class="max-w-5xl mx-auto px-5 sm:px-6 py-16 sm:py-24 border-t border-white/[0.06]">
    <div class="reveal max-w-2xl mb-12">
      <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-tirma-pink/80 mb-2">Cómo funciona</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.02em]">De tu perfil a tu primer cobro, en cuatro pasos.</h2>
    </div>
    <div class="grid sm:grid-cols-2 gap-x-10 gap-y-9">
      {steps.map((s) => (
        <div class="reveal flex gap-5">
          <div class="text-tirma-pink/50 font-bold text-sm pt-1 flex-shrink-0" style="font-variant-numeric:tabular-nums">{s.n}</div>
          <div>
            <h3 class="font-bold text-lg mb-1.5">{s.t}</h3>
            <p class="text-sm text-white/55 leading-relaxed">{s.d}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Tú montas tu oferta: piezas que se combinan como quieras -->
    <div class="reveal mt-14 pt-10 border-t border-white/[0.06]">
      <h3 class="text-xl sm:text-2xl font-bold tracking-[-0.02em] mb-2">Tú montas tu oferta</h3>
      <p class="text-white/55 mb-7 max-w-2xl leading-relaxed">
        Ofreces lo que quieras: desde <strong class="text-white/80">solo tu catálogo</strong> hasta el paquete completo. Seas influencer, guía o agencia, tienes las mismas piezas a tu disposición — combínalas a tu gusto.
      </p>
      <div class="grid sm:grid-cols-3 gap-4">
        {services.map((s) => (
          <div class="reveal p-6 rounded-2xl bg-white/[0.025] border border-white/[0.08]">
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${s.tag === 'La base' ? 'bg-tirma-pink/15 text-tirma-beige border border-tirma-pink/25' : 'bg-white/[0.06] text-white/50 border border-white/[0.12]'}`}>{s.tag}</span>
            </div>
            <div class="font-bold text-lg mb-2">{s.name}</div>
            <p class="text-sm text-white/55 leading-relaxed">{s.d}</p>
          </div>
        ))}
      </div>
      <p class="text-xs text-white/35 mt-4">Y no estás atado a estas: puedes crear los servicios a medida que quieras, cada uno con su precio y su canal de contacto.</p>
    </div>
  </section>

  <!-- CUÁNTO GANAS -->
  <section class="max-w-4xl mx-auto px-5 sm:px-6 py-16 sm:py-24">
    <div class="reveal text-center max-w-xl mx-auto mb-10">
      <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-tirma-pink/80 mb-2">Cuánto ganas</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.02em]">Las cuentas claras.</h2>
    </div>
    <div class="reveal rounded-3xl border border-white/[0.1] bg-white/[0.02] p-6 sm:p-8">
      <div class="flex items-baseline justify-between mb-4">
        <span class="text-sm text-white/55">De una venta de</span>
        <span class="text-xl font-bold" style="font-variant-numeric:tabular-nums">20,00 €</span>
      </div>
      <div class="flex h-16 rounded-2xl overflow-hidden border border-white/[0.08]">
        <div class="flex flex-col justify-center px-5" style="flex:85; background:#171c25">
          <span class="text-[11px] font-bold uppercase tracking-wide text-tirma-beige/80">Para ti · 85%</span>
          <span class="text-lg font-extrabold" style="font-variant-numeric:tabular-nums">17,00 €</span>
        </div>
        <div class="flex flex-col justify-center px-4 text-white" style="flex:15; background:linear-gradient(180deg,#E6157F,#C30F68)">
          <span class="text-[11px] font-bold uppercase tracking-wide opacity-80">getcroquis</span>
          <span class="text-lg font-extrabold" style="font-variant-numeric:tabular-nums">3,00 €</span>
        </div>
      </div>
      <p class="text-sm text-white/45 mt-4">Empezar es <strong class="text-white/70">gratis</strong>: sin cuotas de alta ni mensualidades. Solo cobramos cuando tú cobras — así de simple.</p>
    </div>

    <!-- Cuando vendes de verdad: Creador Pro (mismo dinero, más tuyo) -->
    <div class="reveal mt-4 rounded-3xl border border-tirma-pink/25 bg-gradient-to-br from-tirma-pink/[0.09] to-transparent p-6 sm:p-8">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-3">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-tirma-pink/90">Cuando ya vendes</p>
        <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-tirma-pink/20 text-tirma-beige">Creador Pro · 19,90 €/mes</span>
      </div>
      <h3 class="text-xl sm:text-2xl font-bold tracking-[-0.02em] mb-2">Quédate el <span class="text-tirma-beige">90%</span> y hazlo tuyo.</h3>
      <p class="text-sm text-white/55 leading-relaxed max-w-2xl">
        Esa misma venta de 20 € te deja <strong class="text-white/85" style="font-variant-numeric:tabular-nums">18,00 €</strong> en vez de 17,00 €.
        Y además: <strong class="text-white/85">tu marca</strong> en los itinerarios, <strong class="text-white/85">100 créditos de IA</strong> al mes,
        perfil <strong class="text-white/85">destacado</strong> en el buscador y packs de créditos a precio de socio.
      </p>
      <p class="text-sm text-white/40 mt-3">
        A partir de unos 200 € de ventas al mes, el plan se paga solo. Antes de eso, quédate en gratis — sin prisa.
      </p>
      <a href={`${SITE.appUrl}/planes`} class="inline-flex items-center gap-1.5 mt-5 text-sm font-semibold text-tirma-beige/85 hover:text-tirma-beige">Ver todos los planes →</a>
    </div>
  </section>

  <!-- PARA QUIÉN -->
  <section class="max-w-6xl mx-auto px-5 sm:px-6 pb-16 sm:pb-24">
    <div class="reveal max-w-2xl mb-10">
      <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-tirma-pink/80 mb-2">Para quién</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.02em]">Si vives los viajes, esto es para ti.</h2>
    </div>
    <div class="grid sm:grid-cols-3 gap-4">
      {forWho.map((w, i) => (
        <div class="reveal p-7 rounded-3xl bg-white/[0.025] border border-white/[0.08]" style={`transition-delay:${i * 70}ms`}>
          <h3 class="font-bold text-lg mb-2">{w.t}</h3>
          <p class="text-sm text-white/55 leading-relaxed">{w.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="max-w-4xl mx-auto px-5 sm:px-6 pb-24">
    <div class="reveal relative rounded-[2rem] overflow-hidden border border-white/[0.08] px-6 sm:px-12 py-14 sm:py-20 text-center">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-br from-tirma-pink/[0.14] via-transparent to-tirma-beige/[0.06]"></div>
      <div class="relative">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.02em]">Empieza a vender tus viajes hoy.</h2>
        <p class="text-white/55 mt-3 mb-8 max-w-md mx-auto">Crea tu cuenta gratis y solicita ser creador. Sin coste, sin compromiso.</p>
        <a href={`${SITE.appUrl}/creador?tipo=creador`} class="inline-block px-9 py-4 rounded-full bg-tirma-pink text-white font-semibold shadow-xl shadow-tirma-pink/25 hover:bg-tirma-deep transition">
          Hazte creador
        </a>
        <p class="mt-5 text-sm text-white/40">¿Eres una agencia de viajes? <a href="/agencias" class="text-tirma-beige/80 hover:text-tirma-beige underline underline-offset-2">Tenemos algo distinto para ti →</a></p>
      </div>
    </div>
  </section>

  <script>
    // Aparición al hacer scroll: sin esto, los elementos .reveal se quedan
    // invisibles (opacity:0) y la página parece vacía. (La home tiene el mismo.)
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</Base>
