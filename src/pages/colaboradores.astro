---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { PROVINCIAS, AGENCIAS } from '../data/agenciasColaboradoras.js';

// Mapa provincia -> agencia (la primera dada de alta ocupa la plaza).
const byProvincia = new Map();
for (const a of AGENCIAS) if (a?.provincia && !byProvincia.has(a.provincia)) byProvincia.set(a.provincia, a);

const provincias = [...PROVINCIAS].sort((x, y) => x.localeCompare(y, 'es'));
const ocupadas = provincias.filter((p) => byProvincia.has(p)).length;
const inicial = (s) => (s || '?').trim().charAt(0).toUpperCase();
---

<Base title="Agencias colaboradoras de getcroquis" description="Directorio de agencias de viaje colaboradoras de getcroquis, una por provincia. Profesionales verificados que diseñan itinerarios a medida y atienden a viajeros de todo el mundo.">

  <!-- HERO -->
  <section class="max-w-4xl mx-auto px-5 sm:px-6 pt-14 sm:pt-20 pb-6 text-center">
    <p class="reveal text-[11px] sm:text-xs font-semibold tracking-[0.22em] uppercase text-tirma-pink/80 mb-6">Red de colaboradores</p>
    <h1 class="reveal text-[2.3rem] leading-[1.07] sm:text-[3.6rem] sm:leading-[1.03] font-extrabold tracking-[-0.03em]">
      Agencias colaboradoras de <span class="bg-gradient-to-r from-tirma-pink to-tirma-beige bg-clip-text text-transparent">getcroquis</span>
    </h1>
    <p class="reveal mt-6 text-base sm:text-xl text-white/60 max-w-2xl mx-auto leading-relaxed">
      Profesionales verificados, <strong class="text-white/80">una agencia por provincia</strong>, que diseñan itinerarios a medida y atienden a viajeros de todo el mundo. Estar aquí es un sello de confianza — y las plazas son limitadas.
    </p>
    <div class="reveal mt-6 inline-flex items-center gap-2 text-sm text-white/50 rounded-full bg-white/[0.04] border border-white/[0.09] px-4 py-2">
      <span class="w-2 h-2 rounded-full bg-tirma-pink"></span>
      {ocupadas} de {provincias.length} provincias con agencia colaboradora
    </div>
  </section>

  <!-- CÓMO LUCE TU FICHA (preview del template) -->
  <section class="max-w-3xl mx-auto px-5 sm:px-6 py-8">
    <p class="reveal text-center text-xs text-white/40 mb-3">Así lucirá tu ficha de agencia colaboradora:</p>
    <div class="reveal mx-auto max-w-md p-5 rounded-3xl bg-gradient-to-b from-tirma-pink/[0.08] to-transparent border border-tirma-pink/25">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-tirma-pink/15 border border-tirma-pink/25 flex items-center justify-center text-tirma-beige font-extrabold text-xl flex-shrink-0">TA</div>
        <div class="min-w-0">
          <div class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-tirma-beige/80 mb-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Agencia colaboradora
          </div>
          <div class="font-bold text-lg leading-tight truncate">Tu Agencia de Viajes</div>
          <div class="text-sm text-white/50">Tu ciudad · tu provincia</div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAPA POR PROVINCIA -->
  <section class="max-w-6xl mx-auto px-5 sm:px-6 pb-16 sm:pb-24">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {provincias.map((prov) => {
        const a = byProvincia.get(prov);
        if (a) {
          const href = a.web || `${SITE.appUrl}`;
          return (
            <a href={href} target="_blank" rel="noreferrer" class="reveal group p-5 rounded-2xl bg-white/[0.03] border border-white/[0.1] hover:border-tirma-pink/40 transition flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl overflow-hidden bg-tirma-pink/15 border border-tirma-pink/25 flex items-center justify-center text-tirma-beige font-bold flex-shrink-0">
                {a.logo ? <img src={a.logo} alt={a.nombre} class="w-full h-full object-cover" /> : inicial(a.nombre)}
              </div>
              <div class="min-w-0">
                <div class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-tirma-beige/80">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> {prov}
                </div>
                <div class="font-bold leading-tight truncate">{a.nombre}</div>
                <div class="text-xs text-white/45 truncate">{[a.ciudad, a.direccion].filter(Boolean).join(' · ') || 'Agencia colaboradora'}</div>
              </div>
            </a>
          );
        }
        return (
          <a href="/agencias" class="reveal group p-5 rounded-2xl bg-white/[0.015] border border-dashed border-white/[0.1] hover:border-tirma-pink/40 hover:bg-white/[0.03] transition flex items-center justify-between gap-3">
            <div class="min-w-0">
              <div class="font-semibold text-white/70 truncate">{prov}</div>
              <div class="text-xs text-white/35">Plaza disponible</div>
            </div>
            <span class="text-xs font-bold text-tirma-beige/70 group-hover:text-tirma-beige whitespace-nowrap">Reservar →</span>
          </a>
        );
      })}
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-4xl mx-auto px-5 sm:px-6 pb-24">
    <div class="reveal relative rounded-[2rem] overflow-hidden border border-white/[0.08] px-6 sm:px-12 py-14 text-center">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-br from-tirma-pink/[0.14] via-transparent to-tirma-beige/[0.06]"></div>
      <div class="relative">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-[-0.02em]">¿Tu provincia sigue libre?</h2>
        <p class="text-white/55 mt-3 mb-8 max-w-md mx-auto">Sé la agencia colaboradora de tu zona y quédate el −50% de por vida del programa fundador.</p>
        <a href="/agencias" class="inline-block px-9 py-4 rounded-full bg-tirma-pink text-white font-semibold shadow-xl shadow-tirma-pink/25 hover:bg-tirma-deep transition">Reserva tu plaza</a>
      </div>
    </div>
  </section>

  <script>
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</Base>
